<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Temporalio.Extensions.MicrosoftAgentFramework</PackageId>
    <RootNamespace>Temporalio.Extensions.MicrosoftAgentFramework</RootNamespace>
    <Version>0.0.0</Version>
    <IsPackable>true</IsPackable>
    <Description>Temporal integration for Microsoft Agent Framework (Pre-release)</Description>
    <PackageTags>temporal;workflow;durable-execution;ai;agents;microsoft-agent-framework</PackageTags>
    <PackageProjectUrl>https://github.com/temporalio/ai-integrations/tree/main/dotnet/microsoft-agent-framework</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Temporalio.Extensions.MicrosoftAgentFramework.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.22.0" />
    <PackageReference Include="Temporalio.Extensions.WorkflowStreams" Version="1.22.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="[1.26.0,2.0.0)" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
</Project>
