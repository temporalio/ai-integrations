<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- minPublishAgeHours is the dependency cooldown (14 days). NuGet's accepted cooldown spec reads it
         from here; until that ships, scripts/ci/check_dotnet_deps.py enforces it on the committed locks. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" minPublishAgeHours="336" />
  </packageSources>
  <minPublishAgeExceptions>
    <!-- First-party packages are adoptable the day they ship (the exclude-newer-package = { temporalio = false } rule). -->
    <package pattern="Temporalio*" />
  </minPublishAgeExceptions>
</configuration>
