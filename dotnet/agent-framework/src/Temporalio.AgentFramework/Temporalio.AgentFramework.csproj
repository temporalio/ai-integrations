<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Temporalio.AgentFramework</PackageId>
    <RootNamespace>Temporalio.AgentFramework</RootNamespace>
    <Version>0.0.0</Version>
    <IsPackable>true</IsPackable>
    <Description>Temporal integration for Microsoft Agent Framework (Pre-release)</Description>
    <PackageTags>temporal;workflow;durable-execution;ai;agents;microsoft-agent-framework</PackageTags>
    <PackageProjectUrl>https://github.com/temporalio/ai-integrations/tree/main/dotnet/agent-framework</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Temporalio" Version="1.22.0" />
    <PackageReference Include="Temporalio.Extensions.WorkflowStreams" Version="1.22.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.3.180" PrivateAssets="all" />
  </ItemGroup>
</Project>
