<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rendered by scripts/ci/smoke_dotnet.py into a temporary directory outside the repository.
       The consumer sees only the restored package: no plugin source, no test dependencies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>__TFM__</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="__COORDINATE__" Version="[__VERSION__]" />
  </ItemGroup>
</Project>
