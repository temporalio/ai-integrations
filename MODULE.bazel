"""Independent AI integrations; ecosystem manifests remain dependency authorities."""

module(name = "ai_integrations")

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "rules_python", version = "2.4.1")
bazel_dep(name = "toml.bzl", version = "0.5.0")

include("//go:_deps.MODULE.bazel")
include("//java:_deps.MODULE.bazel")
include("//python:_deps.MODULE.bazel")
include("//typescript:_deps.MODULE.bazel")

metadata = use_repo_rule("//bazel:metadata.bzl", "plugin_metadata")

metadata(
    name = "plugin_metadata",
    root = "//:MODULE.bazel",
)

include("//bazel:temporal.MODULE.bazel")
