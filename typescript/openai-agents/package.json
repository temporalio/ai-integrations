{
  "name": "@temporalio/openai-agents",
  "version": "0.0.0",
  "description": "Temporal OpenAI Agents SDK integration package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "workflow": [
        "./lib/workflow.d.ts"
      ],
      "workflow-interceptor": [
        "./lib/workflow/trace-interceptor.d.ts"
      ],
      "otel": [
        "./lib/otel.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --build tests/helpers tsconfig.json",
    "lint": "pnpm run build && eslint --config ../_shared/eslint.config.mjs src",
    "test": "ava",
    "pack": "pnpm pack --pack-destination dist"
  },
  "ava": {
    "files": [
      "./lib/__tests__/**/*.test.js",
      "./lib/__tests__/test-*.js"
    ],
    "timeout": "120s",
    "concurrency": 1,
    "workerThreads": false
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./workflow": {
      "types": "./lib/workflow.d.ts",
      "import": "./lib/workflow.js",
      "require": "./lib/workflow.js",
      "default": "./lib/workflow.js"
    },
    "./workflow-interceptor": {
      "types": "./lib/workflow/trace-interceptor.d.ts",
      "import": "./lib/workflow/trace-interceptor.js",
      "require": "./lib/workflow/trace-interceptor.js",
      "default": "./lib/workflow/trace-interceptor.js"
    },
    "./otel": {
      "types": "./lib/otel.d.ts",
      "import": "./lib/otel.js",
      "require": "./lib/otel.js",
      "default": "./lib/otel.js"
    }
  },
  "keywords": [
    "temporal",
    "workflow",
    "ai",
    "openai",
    "agents"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/plugin": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/workflow-streams": "^1.24.0",
    "@ungap/structured-clone": "^1.3.1",
    "headers-polyfill": "^4.0.3",
    "web-streams-polyfill": "^4.2.0"
  },
  "peerDependencies": {
    "@openai/agents-core": "~0.14.3",
    "@openai/agents-openai": "~0.14.3",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "long": "^5.3.2",
    "openai": "^6.46.0",
    "protobufjs": "^8.7.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openai/agents-core": "~0.14.3",
    "@openai/agents-openai": "~0.14.3",
    "@opentelemetry/core": "^1.25.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "@temporalio/client": "^1.24.0",
    "@temporalio/proto": "^1.24.0",
    "@temporalio/test-helpers": "link:tests/helpers",
    "@temporalio/testing": "^1.24.0",
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "nexus-rpc": "^0.0.3",
    "openai": "^6.46.0",
    "protobufjs": "^8.7.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.19.39",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.26.0",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-config-prettier": "^9.1.0",
    "@temporalio/envconfig": "^1.24.0",
    "@types/stack-utils": "^2.0.3",
    "stack-utils": "^2.0.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/temporalio/ai-integrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/ai-integrations.git",
    "directory": "typescript/openai-agents"
  },
  "homepage": "https://github.com/temporalio/ai-integrations/tree/main/typescript/openai-agents",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__",
    "LICENSE"
  ],
  "private": true,
  "packageManager": "pnpm@10.27.0"
}
