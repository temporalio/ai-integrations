node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")
node.toolchain(
    name = "node22",
    node_version = "22.20.0",
)
use_repo(node, "node22_toolchains", "nodejs_toolchains")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version = "10.34.5")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_tools",
    data = [
        "//typescript/_tools:package.json",
        "//typescript/_tools:pnpm-workspace.yaml",
    ],
    lifecycle_hooks = {
        "@temporalio/core-bridge": ["postinstall"],
        "esbuild": ["postinstall"],
        "protobufjs": ["postinstall"],
    },
    pnpm_lock = "//typescript/_tools:pnpm-lock.yaml",
    update_pnpm_lock = False,
)
use_repo(npm, "npm_tools")

