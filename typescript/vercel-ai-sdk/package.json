{
  "name": "@temporalio/vercel-ai-sdk",
  "version": "0.0.0",
  "description": "Temporal AI SDK integration package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./workflow": {
      "types": "./lib/workflow.d.ts",
      "import": "./lib/workflow.js",
      "require": "./lib/workflow.js",
      "default": "./lib/workflow.js"
    }
  },
  "typesVersions": {
    "*": {
      "workflow": [
        "./lib/workflow.d.ts"
      ]
    }
  },
  "keywords": [
    "temporal",
    "workflow",
    "ai",
    "ai-sdk",
    "llm",
    "embeddings"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "scripts": {
    "build": "tsc --build tests/helpers tsconfig.json",
    "lint": "pnpm run build && eslint --config ../_shared/eslint.config.mjs src",
    "test": "ava",
    "pack": "pnpm pack --pack-destination dist"
  },
  "ava": {
    "timeout": "120s",
    "concurrency": 1,
    "workerThreads": false,
    "files": [
      "./lib/__tests__/**/*.test.js",
      "./lib/__tests__/test-*.js"
    ]
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/plugin": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/workflow-streams": "^1.24.0",
    "@ungap/structured-clone": "^1.3.1",
    "headers-polyfill": "^4.0.3",
    "web-streams-polyfill": "^4.2.0",
    "base64-js": "^1.5.1"
  },
  "peerDependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/provider": "^4.0.21",
    "ai": "^7.0.127",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "@ai-sdk/mcp": "^2.0.66",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/otel": "^1.0.127",
    "@ai-sdk/provider": "^4.0.21",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^1.25.1",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "@temporalio/client": "^1.24.0",
    "@temporalio/interceptors-opentelemetry": "^1.24.0",
    "@temporalio/proto": "^1.24.0",
    "@temporalio/test-helpers": "link:tests/helpers",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@types/ungap__structured-clone": "^1.2.0",
    "ai": "^7.0.127",
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1",
    "zod": "^3.25.76",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.19.39",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.26.0",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-config-prettier": "^9.1.0",
    "@temporalio/envconfig": "^1.24.0",
    "@types/stack-utils": "^2.0.3",
    "stack-utils": "^2.0.6"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/temporalio/ai-integrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/ai-integrations.git",
    "directory": "typescript/vercel-ai-sdk"
  },
  "homepage": "https://github.com/temporalio/ai-integrations/tree/main/typescript/vercel-ai-sdk",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__",
    "LICENSE"
  ],
  "private": true,
  "packageManager": "pnpm@10.27.0"
}
