{
  "name": "@temporalio/langsmith",
  "version": "0.0.0",
  "description": "Temporal LangSmith observability integration package",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "workflow-interceptors": [
        "./lib/workflow-interceptors.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "pnpm run build && eslint --config ../_shared/eslint.config.mjs src",
    "test": "ava",
    "pack": "pnpm pack --pack-destination dist"
  },
  "ava": {
    "files": [
      "./lib/__tests__/**/*.test.js",
      "./lib/__tests__/test-*.js"
    ],
    "timeout": "120s",
    "concurrency": 1,
    "workerThreads": false
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./workflow-interceptors": {
      "types": "./lib/workflow-interceptors.d.ts",
      "import": "./lib/workflow-interceptors.js",
      "require": "./lib/workflow-interceptors.js",
      "default": "./lib/workflow-interceptors.js"
    }
  },
  "keywords": [
    "temporal",
    "workflow",
    "ai",
    "langsmith",
    "observability",
    "tracing"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/plugin": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0"
  },
  "peerDependencies": {
    "langsmith": "^0.10.8",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "ava": "^5.3.1",
    "langsmith": "^0.10.8",
    "long": "^5.3.2",
    "nexus-rpc": "^0.0.3",
    "protobufjs": "^8.7.1",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.19.39",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.26.0",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-config-prettier": "^9.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bugs": {
    "url": "https://github.com/temporalio/ai-integrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/ai-integrations.git",
    "directory": "typescript/langsmith"
  },
  "homepage": "https://github.com/temporalio/ai-integrations/tree/main/typescript/langsmith",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.27.0"
}
