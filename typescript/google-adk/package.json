{
  "name": "@temporalio/google-adk",
  "version": "0.0.0",
  "description": "Temporal plugin for the Google Agent Development Kit (@google/adk): run ADK agents as durable Temporal Workflows.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "workflow": [
        "./lib/workflow.d.ts"
      ],
      "testing": [
        "./lib/testing.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./workflow": {
      "types": "./lib/workflow.d.ts",
      "import": "./lib/workflow.js",
      "require": "./lib/workflow.js",
      "default": "./lib/workflow.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "import": "./lib/testing.js",
      "require": "./lib/testing.js",
      "default": "./lib/testing.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "pnpm run build && eslint --config ../_shared/eslint.config.mjs src",
    "test": "ava",
    "pack": "pnpm pack --pack-destination dist"
  },
  "ava": {
    "files": [
      "./lib/__tests__/**/*.test.js"
    ],
    "timeout": "120s",
    "concurrency": 4,
    "workerThreads": false
  },
  "keywords": [
    "temporal",
    "google",
    "adk",
    "agents",
    "ai",
    "durable",
    "workflow"
  ],
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@temporalio/activity": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/plugin": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@temporalio/workflow-streams": "^1.24.0",
    "@ungap/structured-clone": "^1.3.1",
    "headers-polyfill": "^4.0.3",
    "uuid": "^11.1.0",
    "web-streams-polyfill": "^4.2.0",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@google/adk": ">=2.0.0 <2.4.0",
    "@google/genai": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1"
  },
  "devDependencies": {
    "@google/adk": ">=2.0.0 <2.4.0",
    "@google/genai": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-trace-base": "^1.25.1",
    "@temporalio/interceptors-opentelemetry": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@types/node": "^20.19.39",
    "ava": "^5.3.1",
    "long": "^5.3.2",
    "protobufjs": "^8.7.1",
    "@tsconfig/node20": "^20.1.4",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.26.0",
    "@eslint/js": "^9.26.0",
    "typescript-eslint": "^8.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-config-prettier": "^9.1.0"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "bugs": {
    "url": "https://github.com/temporalio/ai-integrations/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/ai-integrations.git",
    "directory": "typescript/google-adk"
  },
  "homepage": "https://github.com/temporalio/ai-integrations/tree/main/typescript/google-adk",
  "files": [
    "src",
    "lib",
    "!src/__tests__",
    "!lib/__tests__",
    "LICENSE"
  ],
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.27.0"
}
