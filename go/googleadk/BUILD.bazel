go_test(
    name = "lint",
    srcs = ["//go/_tools:format_test.go"],
    data = [":format_sources"],
    env = {"GO_PLUGIN_FILES": "$(rlocationpaths :format_sources)"},
    deps = ["@rules_go//go/runfiles"],
)

filegroup(
    name = "format_sources",
    srcs = glob(["*.go"]) + ["//go/googleadk/internal/pluginwarn:format_sources"],
)

