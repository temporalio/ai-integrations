startup --windows_enable_symlinks
common --incompatible_strict_action_env
common --incompatible_default_to_explicit_init_py
common --repo_env=DO_NOT_TRACK=1
common --@rules_python//python/config_settings:python_version=3.14
common --@aspect_rules_ts//ts:default_to_tsc_transpiler
test --test_output=errors
test --local_test_jobs=4
build --lockfile_mode=error
build --enable_runfiles
common:py310 --@rules_python//python/config_settings:python_version=3.10
common:py310 --platform_suffix=py310
common:py311 --@rules_python//python/config_settings:python_version=3.11
common:py311 --platform_suffix=py311
common:py314 --@rules_python//python/config_settings:python_version=3.14
common:node22 --extra_toolchains=@node22_toolchains//:all
common:node22 --platform_suffix=node22
common:node24 --extra_toolchains=@nodejs_toolchains//:all
common:node24 --platform_suffix=node24
common:java17 --java_runtime_version=remotejdk_17
common:java17 --platform_suffix=java17
common:java25 --java_runtime_version=remotejdk_25
common:java25 --platform_suffix=java25
build --java_language_version=17
build --java_runtime_version=remotejdk_25
common:go126 --@rules_go//go/toolchain:sdk_version=1.26.6
common:go126 --platform_suffix=go126
common:go127 --@rules_go//go/toolchain:sdk_version=1.27.2
common:go127 --platform_suffix=go127
common:ci --nobuild_runfile_links
try-import %workspace%/user.bazelrc
common --experimental_isolated_extension_usages
build --tool_java_language_version=17
build --tool_java_runtime_version=remotejdk_25
