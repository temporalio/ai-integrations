# Normalize line endings: everything is committed with LF, including on Windows checkouts.
* text=auto eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.mk text eol=lf
Makefile text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.whl binary
*.tar.gz binary
