load("@contrib_rules_jvm//java:defs.bzl", "java_junit5_test")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

java_library(
    name = "tools",
    srcs = glob(
        ["src/main/java/**/*.java"],
        exclude = ["**/Format.java"],
    ),
    deps = [
        "@maven_java_tools//:com_fasterxml_jackson_core_jackson_databind",
        "@maven_java_tools//:org_tomlj_tomlj",
        "@rules_java//java/runfiles",
    ],
)

[java_binary(
    name = name,
    data = [
        "//bazel/temporal:gradle",
        "@gradle_consumer//:distribution",
        "@plugin_metadata//:plugins.json",
    ],
    env = {"GRADLE_RUNFILE": "$(rlocationpath //bazel/temporal:gradle)"},
    main_class = "io.temporal.integrations.tools." + cls,
    visibility = ["//visibility:public"],
    runtime_deps = [":tools"],
) for name, cls in [
    ("release", "Release"),
    ("package", "PackageTool"),
    ("ci", "Ci"),
    ("dev", "Dev"),
]]

java_junit5_test(
    name = "tool_tests",
    srcs = glob(["src/test/java/**/*.java"]),
    test_class = "io.temporal.integrations.tools.ToolsTest",
    runtime_deps = [
        "@maven_java_tools//:org_junit_jupiter_junit_jupiter_engine",
        "@maven_java_tools//:org_junit_platform_junit_platform_launcher",
        "@maven_java_tools//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":tools",
        "@maven_java_tools//:org_junit_jupiter_junit_jupiter_api",
    ],
)

exports_files(glob(["maven/*.json"]))

java_binary(
    name = "format",
    srcs = ["src/main/java/io/temporal/integrations/tools/Format.java"],
    jvm_flags = [
        "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
        "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED",
    ],
    main_class = "io.temporal.integrations.tools.Format",
    visibility = ["//visibility:public"],
    runtime_deps = ["@maven_java_tools//:com_google_googlejavaformat_google_java_format"],
    deps = ["@maven_java_tools//:com_google_googlejavaformat_google_java_format"],
)
