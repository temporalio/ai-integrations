config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "cli",
    actual = select({
        ":darwin_amd64": "@temporal_cli_darwin_amd64//:temporal",
        ":darwin_arm64": "@temporal_cli_darwin_arm64//:temporal",
        ":linux_amd64": "@temporal_cli_linux_amd64//:temporal",
        ":linux_arm64": "@temporal_cli_linux_arm64//:temporal",
        ":windows_amd64": "@temporal_cli_windows_amd64//:temporal.exe",
        ":windows_arm64": "@temporal_cli_windows_arm64//:temporal.exe",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "cli_python",
    actual = select({
        ":darwin_amd64": "@temporal_cli_python_darwin_amd64//:temporal",
        ":darwin_arm64": "@temporal_cli_python_darwin_arm64//:temporal",
        ":linux_amd64": "@temporal_cli_python_linux_amd64//:temporal",
        ":linux_arm64": "@temporal_cli_python_linux_arm64//:temporal",
        ":windows_amd64": "@temporal_cli_python_windows_amd64//:temporal.exe",
        ":windows_arm64": "@temporal_cli_python_windows_arm64//:temporal.exe",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "gradle",
    actual = select({
        "@platforms//os:windows": "@gradle_consumer//:bin/gradle.bat",
        "//conditions:default": "@gradle_consumer//:bin/gradle",
    }),
    visibility = ["//visibility:public"],
)
